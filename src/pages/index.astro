---
import Layout from '../layouts/Layout.astro';
import LeftSide from '../components/LeftSide.astro';
import RightSide from '../components/RightSide.astro';
import Manifesto from '../components/Manifesto.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout>
    <ThemeToggle />
	<main class="max-w-7xl mx-auto px-6 py-12 md:py-24" id="main-content">
	  <LeftSide />
      <Manifesto />
	  <RightSide />
	</main>
</Layout>
