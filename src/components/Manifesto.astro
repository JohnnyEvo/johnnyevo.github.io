---
import ThemeToggle from "./ThemeToggle.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="my-32 border-y-8 border-text px-8 py-20 bg-accent-yellow dark:bg-accent-yellow/10">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 text-text">
    <div class="flex flex-col gap-6">
      <span class="text-7xl font-black opacity-20 leading-none">01</span>
      <h3 class="font-title font-black text-2xl uppercase tracking-tighter">{t('manifesto.01.title')}</h3>
      <p class="font-bold leading-snug uppercase text-xs tracking-tight">
        {t('manifesto.01.desc')}
      </p>
    </div>
    <div class="flex flex-col gap-6">
      <span class="text-7xl font-black opacity-20 leading-none">02</span>
      <h3 class="font-title font-black text-2xl uppercase tracking-tighter">{t('manifesto.02.title')}</h3>
      <p class="font-bold leading-snug uppercase text-xs tracking-tight">
        {t('manifesto.02.desc')}
      </p>
    </div>
    <div class="flex flex-col gap-6">
      <span class="text-7xl font-black opacity-20 leading-none">03</span>
      <h3 class="font-title font-black text-2xl uppercase tracking-tighter">{t('manifesto.03.title')}</h3>
      <p class="font-bold leading-snug uppercase text-xs tracking-tight">
        {t('manifesto.03.desc')}
      </p>
    </div>
    <div class="flex flex-col gap-6">
      <span class="text-7xl font-black opacity-20 leading-none">04</span>
      <h3 class="font-title font-black text-2xl uppercase tracking-tighter">{t('manifesto.04.title')}</h3>
      <p class="font-bold leading-snug uppercase text-xs tracking-tight">
        {t('manifesto.04.desc')}
      </p>
    </div>
  </div>
</section>
