---
const { targetId } = Astro.props;
---

<script>
  import { useTeleport } from "../composables/teleport";
  import {
    enter as useEnterModal,
    leave as useLeaveModal,
  } from "../transitions/modal";

  const modalElements = Array.from(
    document.getElementsByClassName("modal-js") as HTMLCollection
  ) as HTMLElement[];
  const bodyElement = document.querySelector("body") as HTMLElement;
  const closeModalElements = document.querySelectorAll(".modal-js button");
  let lastFocusedElement: HTMLElement | null = null;

  bodyElement.addEventListener("modal", async (e) => {
    lastFocusedElement = document.activeElement as HTMLElement;
    
    modalElements.filter(async (modalElement: HTMLElement) => {
      if (modalElement.getAttribute("data-target-id") === (e as CustomEvent).detail.id) {
        modalElement.classList.remove("hidden");
        bodyElement.classList.add("overflow-hidden");
        
        await useEnterModal(modalElement);
        
        // Focus the close button for accessibility
        const closeBtn = modalElement.querySelector('button');
        if (closeBtn) closeBtn.focus();
      }
    });
  });

  bodyElement.addEventListener("keydown", async (e) => {
    if (e.key === "Escape") {
      await closeModal();
    }
  });

  closeModalElements.forEach((closeModalElement) => {
    closeModalElement.addEventListener("click", async () => {
      await closeModal();
    });
  });

  const closeModal = async () => {
    for (const modalElement of modalElements) {
      if (!modalElement.classList.contains("hidden")) {
        await useLeaveModal(modalElement);
        modalElement.classList.add("hidden");
        bodyElement.classList.remove("overflow-hidden");
        
        // Restore focus
        if (lastFocusedElement) {
          lastFocusedElement.focus();
        }
      }
    }
  };

  modalElements.forEach((modalElement) => {
    useTeleport(modalElement);
  });
</script>

<div
  class="hidden overflow-hidden fixed w-0 h-0 bg-bg z-[100] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 modal-js brutalist-border brutalist-shadow"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`title-${targetId}`}
  data-target-id={targetId}
>
  <button
    class="z-[110] absolute top-4 right-4 bg-accent-pink brutalist-border p-2 brutalist-shadow-sm hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none transition-all focus:outline-4 focus:outline-accent"
    aria-label="Fermer la modale"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      xmlns="http://www.w3.org/2000/svg"
      ><path
        d="M18 6L6 18M6 6l12 12"
      ></path>
    </svg>
  </button>
  <slot />
</div>
