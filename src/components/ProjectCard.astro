---
import { Image } from "astro:assets";

const { project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{jpeg,jpg,png,gif,webp,avif}');
const imagePath = `/src/assets/img/${project.frontmatter.miniature}.png`;

if (!images[imagePath]) {
  throw new Error(`"${imagePath}" does not exist in glob: "src/assets/img/*.{jpeg,jpg,png,gif,webp,avif}"`);
}
---

<figure
  class="h-screen overflow-hidden group cursor-pointer relative md:h-project-card brutalist-border brutalist-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all duration-200 bg-white focus-within:outline focus-within:outline-4 focus-within:outline-accent"
  role="button"
  tabindex="0"
  aria-label={`Voir les détails du projet ${project.frontmatter.title}`}
>
  <Image
    src={images[imagePath]()}
    alt={`Capture d'écran miniature du projet ${project.frontmatter.title}`}
    width={500}
    height={400}
    class="object-cover w-full h-full opacity-80 group-hover:opacity-100 transition-opacity"
  />
  <figcaption
    class="flex flex-col justify-center items-center text-text absolute bottom-0 left-0 z-10 w-full p-4 bg-accent-yellow border-t-4 border-black"
  >
    <h3 class="font-bold font-title uppercase text-xl">{project.frontmatter.title}</h3>
    <p class="text-xs font-bold uppercase tracking-wider text-center line-clamp-1">
      {project.frontmatter.description}
    </p>
  </figcaption>
</figure>
