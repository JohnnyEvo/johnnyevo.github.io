---
import ProjectCard from "./ProjectCard.astro";
import Modal from "./Modal.astro";
import Project from "./Project.astro";

const projects = await Object.values(import.meta.glob("../projects/*.mdx", { eager: true })) as any[];

const sortedProjects = projects.sort((a, b) => {
  return b.frontmatter.sequence - a.frontmatter.sequence;
});
---

<script>
  import { useProjectsAppear } from "../composables/projectsAppear";
  import { useModal } from "../composables/modal";

  await useProjectsAppear();
  useModal();
</script>

<div class="mt-24">
  <h2 class="font-title font-black text-4xl md:text-6xl uppercase tracking-tighter mb-12 border-b-8 border-text inline-block">
    Sélection de travaux
  </h2>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
    {
      sortedProjects.map((project) => (
        <div
          class="project-js"
          id={project.frontmatter.title}
        >
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</div>

{
  sortedProjects.map((project) => (
    <Modal targetId={project.frontmatter.title}>
      <Project project={project}></Project>
    </Modal>
  ))
}
