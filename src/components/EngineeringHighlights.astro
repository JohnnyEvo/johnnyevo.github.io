---
const highlights = [
  {
    category: "Architecture Mobile Hybride",
    title: "Convergence Native & Web",
    description: "Conception d'architectures cross-platform sous Ionic 8 et Capacitor. Gestion avancée des APIs natives : permissions hardware complexes, intégrations santé (HealthKit / Health Connect) et stratégies de stockage hors-ligne pour des environnements critiques.",
    tags: ["Ionic 8", "Capacitor", "Mobile Health", "Native APIs"]
  },
  {
    category: "Industrialisation SaaS",
    title: "Vélocité & Systèmes Complexes",
    description: "Accélération du Time-to-Market via Laravel et Filament. Mise en place de structures multi-tenant robustes, de tunnels de monétisation hybrides (Stripe/IAP) et de tableaux de bord administratifs haute performance, le tout dans un respect strict du RGPD.",
    tags: ["Laravel 12", "Filament", "Multi-tenancy", "Fintech"]
  },
  {
    category: "Engineering & DevXP",
    title: "Écosystèmes Front-end Durables",
    description: "Pilotage de Monorepos (pnpm) et création de Design Systems headless garantissant l'accessibilité à grande échelle (standards Opquast). Automatisation de la qualité via Playwright (E2E) et Vitest, optimisant la fiabilité des livraisons.",
    tags: ["Monorepo", "Design Systems", "A11y", "Testing"]
  }
];
---

<section class="mt-24">
  <h2 class="font-title font-black text-4xl md:text-6xl uppercase tracking-tighter mb-16 border-b-8 border-text inline-block">
    Engineering Highlights
  </h2>
  
  <div class="grid grid-cols-1 gap-12">
    {highlights.map((item) => (
      <div class="brutalist-border bg-white dark:bg-white/5 p-8 brutalist-shadow transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
          <span class="bg-accent text-white dark:text-text px-3 py-1 text-xs font-black uppercase tracking-widest brutalist-border shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,1)] w-fit">
            {item.category}
          </span>
          <div class="flex flex-wrap gap-2">
            {item.tags.map(tag => (
              <span class="text-[10px] font-bold uppercase border border-text/20 dark:border-text/40 px-2 py-0.5 opacity-60">
                {tag}
              </span>
            ))}
          </div>
        </div>
        
        <h3 class="font-title font-black text-3xl md:text-4xl uppercase tracking-tighter mb-4 italic">
          {item.title}
        </h3>
        
        <p class="text-lg md:text-xl font-medium leading-relaxed max-w-4xl text-text/80 dark:text-text/90">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
