---
import { Image } from "astro:assets";

const { project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{jpeg,jpg,png,gif,webp,avif}');
const imagePath = `/src/assets/img/${project.frontmatter.screenshot}.png`;

if (!images[imagePath]) {
  throw new Error(`"${imagePath}" does not exist in glob: "src/assets/img/*.{jpeg,jpg,png,gif,webp,avif}"`);
}
---

<script>
  import { scroll, animate } from "motion";

  const containerElements = Array.from(
    document.getElementsByClassName("container-js")
  );

  containerElements.forEach((containerElement) => {
    const progressElement = containerElement.querySelector(
      ".progress-js"
    ) as HTMLElement;

    scroll(animate(progressElement, { scaleX: [0, 1] }), {
      container: <HTMLElement>containerElement,
    });
  });

  (document.querySelector("body") as HTMLElement).addEventListener(
    "modal",
    async () => {
      containerElements.forEach((containerElement) => {
        containerElement.scrollTo(0, 0);
      });
    }
  );
</script>

<div class="relative w-full h-full bg-bg">
  <Image
    src={images[imagePath]()}
    alt={`Capture d'écran plein écran du projet ${project.frontmatter.title}`}
    width={1400}
    height={900}
    class="w-full h-full object-cover opacity-20 grayscale"
  />
  <div
    class="absolute w-full h-full top-0 left-0 p-4 md:p-6 overflow-y-auto snap-mandatory snap-y container-js scrollbar-none"
  >
    <article class="min-h-full py-12 flex justify-center items-center snap-center">
      <header
        class="bg-accent-yellow brutalist-border brutalist-shadow max-w-lg w-full p-6 md:p-8"
      >
        <h2 class="font-title text-3xl md:text-5xl font-black uppercase tracking-tighter break-words" id={`title-${project.frontmatter.title}`}>
          {project.frontmatter.title}
        </h2>
        <aside class="text-lg md:text-xl mt-4 font-bold uppercase">{project.frontmatter.description}</aside>
      </header>
    </article>
    {
      project.frontmatter.contents.map(
        (content: { title: string; text: string }) => (
          <div class="min-h-full py-12 flex justify-center items-center snap-center">
            <div class="bg-white brutalist-border brutalist-shadow max-w-lg w-full p-6 md:p-8 overflow-hidden">
              <h2 class="font-title text-2xl md:text-4xl font-black uppercase tracking-tighter mb-4 border-b-4 border-black inline-block break-words">{content.title}</h2>
              <aside class="text-base md:text-lg font-medium leading-relaxed break-words" set:html={content.text} />
            </div>
          </div>
        )
      )
    }
    <div
      class="fixed left-0 right-0 h-4 bottom-0 scale-x-0 progress-js z-40 border-t-4 border-black"
      style={`background-color : ${project.frontmatter.progress_color}`}
    >
    </div>
  </div>
</div>
