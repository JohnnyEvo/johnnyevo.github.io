---
import '../styles/main.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { 
	title = "Johnny Charcosset : Product Engineer & Senior Fullstack",
	description = t('layout.description'),
	image = "https://media.licdn.com/dms/image/v2/D4E03AQGmYuzA2vy0Ow/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1684765953123?e=1750896000&v=beta&t=uQ-U2G_lDub4fR2WuD-0fDZB57044aalb-h1wmuGcyw"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
  		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description}>
		<meta name="author" content="Johnny Charcosset">
		<meta name="keywords" content="développeur web, Johnny Charcosset, portfolio, HTML, CSS, JavaScript, accessibilité, SEO, Vue, frontend, projets, opquast, PHP, Symfony, React, Astro, Tailwind, Laravel, Node, internet, site" />
		<meta name="theme-color" content="#f4f4f0">
		<meta name="robots" content="index, follow">
  		<meta name="googlebot" content="index, follow">

		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title}>
  		<meta property="og:description" content={description}>
  		<meta property="og:type" content="website">
  		<meta property="og:url" content={Astro.url}>
  		<meta property="og:image" content={image}>
		<meta property="og:image:width" content="800">
		<meta property="og:image:height" content="800">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={image}>

		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />

		<title>{title}</title>

		<script is:inline type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Johnny Charcosset",
			"alternateName": "Johnny Evo",
			"url": "https://johnnyevo.github.io/",
			"image": "https://media.licdn.com/dms/image/v2/D4E03AQGmYuzA2vy0Ow/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1684765953123?e=1750896000&v=beta&t=uQ-U2G_lDub4fR2WuD-0fDZB57044aalb-h1wmuGcyw",
			"sameAs": [
				"https://github.com/JohnnyEvo",
				"https://www.linkedin.com/in/johnnycharcosset/"
			],
			"jobTitle": "Product Engineer & Senior Fullstack",
			"description": "Product Engineer spécialisé en architectures cross-platform et SaaS. Expert en accessibilité, performance et éthique numérique.",
			"knowsAbout": [
				"Accessibilité Web",
				"Développement Frontend",
				"Vue",
				"Laravel",
				"Tailwind CSS",
				"SEO",
				"Node.js"
			],
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "FR"
			}
		}
		</script>
	</head>
	<body class="bg-bg text-text selection:bg-accent-yellow selection:text-text">
		<a href="#main-content" class="sr-only focus:not-sr-only fixed top-4 left-4 z-50 bg-accent-yellow brutalist-border px-4 py-2 font-black uppercase brutalist-shadow">
			Aller au contenu principal
		</a>
		<slot />
	</body>
</html>
